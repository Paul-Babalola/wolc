# Supabase (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
# Service role / secret key: server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated staff emails allowed to use /admin (must match Supabase Auth users)
ADMIN_EMAILS=admin@example.com

# Nuxt Studio (https://nuxt.studio) — visual editing for content/ files in production
# Create a GitHub OAuth App: https://github.com/settings/developers
# Callback URL: https://YOUR_DOMAIN/__nuxt_studio/auth/github
# For local OAuth testing: http://localhost:3000/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# Public site URL for sitemap, canonical links, and Open Graph tags
NUXT_PUBLIC_SITE_URL=https://rccgwolc.org

# Optional: YouTube channel for sermon listings (defaults to @WolcNetwork)
# YOUTUBE_CHANNEL_ID=UCG3ywTSflHliywZLUHeyETA

# --- Vercel deploy checklist ---
# 1. Import github.com/Paul-Babalola/wolc (root directory is the app)
# 2. Framework preset: Nuxt.js
# 3. Add all variables above in Project Settings -> Environment Variables
# 4. Apply supabase/migrations/0001-0005 in the Supabase SQL editor
# 5. Verify Resend sender domain for NOTIFY_FROM
# 6. Point rccgwolc.org DNS to Vercel after a staging smoke test

# Resend (https://resend.com) — staff notifications when forms are submitted
RESEND_API_KEY=re_your_api_key
NOTIFY_EMAIL=admin@rccgwordoflifecenter.org
# Use a verified sender once your domain is set up in Resend
NOTIFY_FROM=Word of Life Center <notifications@yourdomain.com>
