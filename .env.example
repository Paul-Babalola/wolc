# Supabase (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
# Service role / secret key: server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated staff emails allowed to use /admin (must match Supabase Auth users)
ADMIN_EMAILS=admin@example.com

# Resend (https://resend.com) — staff notifications when forms are submitted
RESEND_API_KEY=re_your_api_key
NOTIFY_EMAIL=admin@rccgwordoflifecenter.org
# Use a verified sender once your domain is set up in Resend
NOTIFY_FROM=Word of Life Center <notifications@yourdomain.com>
